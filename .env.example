# Lokalne ustawienia backendu. Skopiuj do .env (nie trafia do repo): cp .env.example .env
# cmd/server i testy wczytują .env same; zmienna ustawiona w środowisku wygrywa z plikiem.
# Wartości pasują do lokalnego kontenera z docs/contracts/api.md (planer-pg, port 55432).

# Baza serwera (wymagana).
DATABASE_URL=postgres://planer:planer@localhost:55432/planer?sslmode=disable

# Baza dla testów z bazą; każdy test tworzy w niej własną, tymczasową bazę.
# Bez tej zmiennej testy z bazą są pomijane.
TEST_DATABASE_URL=postgres://planer:planer@localhost:55432/planer?sslmode=disable

# Adres nasłuchu serwera.
ADDR=:8080

# Równoległe uruchomienia solvera (każde zajmuje 4 rdzenie) i limit czekających w kolejce.
WORKERY=1
KOLEJKA=16
